    "@types/nodemailer": "8.0.2",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/smtp-server": "3.5.13",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.4.6",
