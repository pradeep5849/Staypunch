# Keep connection secrets in local/hosting environment settings, never in source control.
# The runtime role must be stay_app, NOSUPERUSER, NOBYPASSRLS, and not own application objects.
DATABASE_URL=
# Remote connections always verify TLS. Local loopback PostgreSQL can use false.
DATABASE_SSL=false
DATABASE_CA_CERT_FILE=
# Alternative for managed hosts without certificate file provisioning (PEM, including escaped newlines).
# Configure exactly one CA source. Use the CA downloaded from the Supabase project.
DATABASE_CA_PEM=
DATABASE_POOL_MAX=5
DATABASE_CONNECT_TIMEOUT_MS=5000
# Operator-only direct/session connection; never present in the web or mailer environment.
MIGRATION_DATABASE_URL=
# Separate stay_mailer login; queue-only privileges from db/email-worker-grants.sql.
EMAIL_DATABASE_URL=
APP_URL=http://localhost:3000
# Optional exact additional public origins, comma-separated; HTTPS required in production.
APP_ALLOWED_ORIGINS=
# One-time operator bootstrap; remove immediately afterward.
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=
# Optional existing HTTPS adapter; explicit provider selection and sending approval are required.
EMAIL_DELIVERY_WEBHOOK=
EMAIL_DELIVERY_TOKEN=
# Only for a local disposable test database; never configure these on production web servers.
TEST_DATABASE_OWNER_URL=
TEST_DATABASE_URL=
TEST_EMAIL_DATABASE_URL=

# SMTP worker stays disabled until separate production approval and a controlled test.
EMAIL_PROVIDER=smtp
EMAIL_SENDING_ENABLED=false
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=staypunch@salespunch360.com
SMTP_FROM=staypunch@salespunch360.com
SMTP_PASSWORD=
EMAIL_BATCH_SIZE=10
EMAIL_MAX_PER_MINUTE=5
# Approved recipient for a token-free controlled test, never used by ordinary queue delivery.
EMAIL_TEST_RECIPIENT=
# Only for the separately approved single-message test; never a persistent production flag.
SMTP_TEST_CONFIRMATION=
