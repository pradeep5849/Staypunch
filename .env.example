# Keep connection secrets in local/hosting environment settings, never in source control.
# The runtime role must be stay_app, NOSUPERUSER, NOBYPASSRLS, and not own application objects.
DATABASE_URL=
# Remote connections always verify TLS. Local loopback PostgreSQL can use false.
DATABASE_SSL=false
DATABASE_CA_CERT_FILE=
DATABASE_POOL_MAX=5
DATABASE_CONNECT_TIMEOUT_MS=5000
# Operator-only direct/session connection; never present in the web or mailer environment.
MIGRATION_DATABASE_URL=
# Separate stay_mailer login; queue-only privileges from db/email-worker-grants.sql.
EMAIL_DATABASE_URL=
APP_URL=http://localhost:3000
# One-time operator bootstrap; remove immediately afterward.
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=
# No delivery is enabled until the HTTPS adapter and token are configured and tested.
EMAIL_DELIVERY_WEBHOOK=
EMAIL_DELIVERY_TOKEN=
# Only for a local disposable test database; never configure these on production web servers.
TEST_DATABASE_OWNER_URL=
TEST_DATABASE_URL=
TEST_EMAIL_DATABASE_URL=
