# Runtime role must NOT own the database or have BYPASSRLS / superuser privileges.
DATABASE_URL=postgresql://stay_app:CHANGE_ME@localhost:5432/staypunch
DATABASE_SSL=false
# Migration owner is available to operators/CI only, never the running web process.
MIGRATION_DATABASE_URL=postgresql://stay_owner:CHANGE_ME@localhost:5432/staypunch
APP_URL=http://localhost:3000
# Set only for one-time bootstrap, then remove from environment.
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=
# Email worker boundary; no delivery provider is silently enabled.
EMAIL_DELIVERY_WEBHOOK=
EMAIL_DELIVERY_TOKEN=
